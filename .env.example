# Copy this file to .env.local and fill in the real values from your Supabase project
# (Project Settings -> API). Never commit .env.local — it's gitignored.

# Safe to expose to the browser (used by the public read-only client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=
