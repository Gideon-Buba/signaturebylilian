# Copy this file to .env.local and fill in the real values from your Supabase project
# (Project Settings -> API). Never commit .env.local — it's gitignored.

# Safe to expose to the browser (used by the public read-only client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack (Project Settings -> API Keys & Webhooks in the Paystack dashboard)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Google Workspace SMTP — used to email new booking notifications to
# bookings@signaturebylilian.com. SMTP_USER is the sending mailbox (can be
# bookings@signaturebylilian.com itself, or another mailbox on the same
# Workspace domain); SMTP_PASS is a Google App Password for that mailbox
# (Google Account -> Security -> 2-Step Verification -> App Passwords —
# requires 2-Step Verification to be turned on for that account).
SMTP_USER=
SMTP_PASS=

